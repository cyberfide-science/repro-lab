# targets/reese-2026-rescore/Dockerfile
# Base image pinned by digest (python:3.12-slim as pulled on 2026-09-27; Python 3.12.14).
# pheval.llm's pyproject.toml at bd7146d declares python = "^3.12".
FROM python@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

ENV OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 \
    PYTHONHASHSEED=0 PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1

# build-essential: chroma-hnswlib 0.7.3 (pinned in malco's lock, via curategpt/chromadb) has no
# Python 3.12 wheel and is compiled from its sdist at install time.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git build-essential \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work
RUN git clone https://github.com/monarch-initiative/pheval.llm.git \
 && cd pheval.llm && git checkout bd7146d15798b4dd968fd64bc9a42e6971aa8fae

# malco's poetry.lock is installed unchanged (generated by Poetry 1.8.4, the same version used here).
# Poetry lives in its own venv so that it and its dependencies are not in the analysis environment;
# the lock is installed into /opt/venv, which is first on PATH, so `pip freeze` lists the lock alone.
# This includes curategpt, openai and llm, which malco imports transitively; the scored run is offline.
RUN python -m venv /opt/poetry && /opt/poetry/bin/pip install poetry==1.8.4 \
 && python -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH
RUN cd /work/pheval.llm \
 && /opt/poetry/bin/poetry config virtualenvs.create false \
 && POETRY_REQUESTS_TIMEOUT=300 /opt/poetry/bin/poetry install --only main --no-interaction \
 && echo "== git status --porcelain in the clone after install (empty means untouched):" \
 && test -z "$(git status --porcelain)" \
 && pip freeze > /work/env-resolved.txt

# Output only: keeps malco's tqdm progress bars out of the committed scorer.log.
ENV TQDM_DISABLE=1
COPY run.sh /work/run.sh
COPY score_rescore.py /work/score_rescore.py
ENTRYPOINT ["bash", "/work/run.sh"]
