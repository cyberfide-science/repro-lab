{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/repro-lab/report.schema.json",
  "title": "Reproducibility report",
  "type": "object",
  "required": ["paper", "verdict", "claims", "environment_delta", "data_provenance",
               "deviations", "cost", "generated_at"],
  "additionalProperties": false,
  "properties": {
    "paper": {
      "type": "object",
      "required": ["doi", "title", "code_sha"],
      "additionalProperties": false,
      "properties": {
        "doi": {"type": "string"},
        "title": {"type": "string"},
        "code_sha": {"type": "string", "minLength": 7}
      }
    },
    "verdict": {"enum": ["reproduced", "partially", "not_reproduced"]},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "figure", "panel", "metric", "claimed", "obtained", "tolerance",
                     "tolerance_type", "extraction", "verdict", "cause_category", "evidence_path"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "figure": {"type": "string"},
          "panel": {"type": ["string", "null"]},
          "metric": {"type": "string"},
          "claimed": {"type": ["number", "string", "array"]},
          "obtained": {"type": ["number", "string", "array", "null"]},
          "tolerance": {"type": ["number", "null"]},
          "tolerance_type": {"enum": ["absolute", "relative", "rank_order", "same_conclusion"]},
          "extraction": {"enum": ["manual", "supplementary_csv", "digitized"]},
          "verdict": {"enum": ["reproduced", "not_reproduced"]},
          "cause_category": {"enum": ["missing_data", "version_drift", "hardware_nondeterminism",
                                      "numerical_precision", "undocumented_step",
                                      "analytical_flexibility", "genuine_error", "undiagnosed", "n/a"]},
          "evidence_path": {"type": "string"}
        },
        "allOf": [
          {"if": {"properties": {"tolerance_type": {"enum": ["absolute", "relative"]}}},
           "then": {"properties": {"tolerance": {"type": "number"}}}},
          {"if": {"properties": {"verdict": {"const": "reproduced"}}},
           "then": {"properties": {"cause_category": {"const": "n/a"}}},
           "else": {"properties": {"cause_category": {"not": {"const": "n/a"}}}}}
        ]
      }
    },
    "environment_delta": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "pinned", "actual"],
        "additionalProperties": false,
        "properties": {
          "component": {"type": "string"},
          "pinned": {"type": "string"},
          "actual": {"type": "string"}
        }
      }
    },
    "data_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "uri", "dest", "sha256_expected", "sha256_actual", "bytes", "fetched_at", "verified"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "uri": {"type": "string"},
          "dest": {"type": "string"},
          "sha256_expected": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sha256_actual": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "fetched_at": {"type": "string", "format": "date-time"},
          "verified": {"type": "boolean"}
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["what", "why", "approved_by", "date"],
        "additionalProperties": false,
        "properties": {
          "what": {"type": "string"},
          "why": {"type": "string"},
          "approved_by": {"type": "string"},
          "date": {"type": "string", "format": "date"}
        }
      }
    },
    "cost": {
      "type": "object",
      "required": ["wall_minutes", "agent_tokens", "usd_estimate"],
      "additionalProperties": false,
      "properties": {
        "wall_minutes": {"type": "number", "minimum": 0},
        "agent_tokens": {"type": "integer", "minimum": 0},
        "usd_estimate": {"type": "number", "minimum": 0}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
